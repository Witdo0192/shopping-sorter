{
  "manifest_version": 3,
  "name": "Shopping Sorter",
  "version": "20.6",
  "description": "Запоминает просмотренные товары и позволяет их гибко сортировать/фильтровать",
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "file:///*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sites.json",
        "units.json"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Сортировать по цене"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "search.js",
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
